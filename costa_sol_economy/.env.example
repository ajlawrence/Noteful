# =============================================================================
# Costa del Sol Economic Monitor - Environment Variables
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit the .env file to git (it's in .gitignore)
#
# =============================================================================

# -----------------------------------------------------------------------------
# ANTHROPIC API (Required for AI features)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# EMAIL ALERTS (Optional - for Gmail notifications)
# -----------------------------------------------------------------------------
# For Gmail, you need an "App Password" (not your regular password)
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Use that 16-character password below

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
ALERT_RECIPIENT=your.email@gmail.com

# -----------------------------------------------------------------------------
# DATA SETTINGS (Optional - defaults are fine)
# -----------------------------------------------------------------------------
# Where to store the database
DATABASE_PATH=data/costa_econ.db

# Cache API responses to avoid hitting rate limits
CACHE_ENABLED=true
CACHE_EXPIRY_HOURS=24

# -----------------------------------------------------------------------------
# LOGGING (Optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/pipeline.log
